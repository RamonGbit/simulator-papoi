# DataStream Networks - Environment Configuration

# API Key de IA (Google Gemini API). Opcional: Si no se provee, el sistema usará el motor analítico heurístico local.
GEMINI_API_KEY=tu_api_key_aqui

# Configuración de Simulación
SIMULATION_SPEED=1.0
DEBUG_MODE=False

# Topología por defecto
TOPOLOGY_CONFIG_PATH=config/default_topology.json
